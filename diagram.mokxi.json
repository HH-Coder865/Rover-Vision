    "uno1": {
      "files": {
        "sketch.ino": "#include<Servo.h>\nServo servo;\nint ena=11;\nint enb=5;\nint in1=10,in2=12,in3=7,in4=6;\nint trig=4,echo=3;\nint getDistance(){\n  digitalWrite(trig,LOW);\n  delayMicroseconds(2);\n  digitalWrite(trig,HIGH);\n  delayMicroseconds(10);\n  digitalWrite(trig,LOW);\n  long time=pulseIn(echo,HIGH);\n  return (int)(time*0.034/2);\n}\nvoid forward(){\n  digitalWrite(in1,LOW);\n  digitalWrite(in2,HIGH);\n  digitalWrite(in4,LOW);\n  digitalWrite(in3,HIGH);\n  analogWrite(ena,180);\n  analogWrite(enb,180);\n}\nvoid stop(){\n  digitalWrite(in1,0);\n  digitalWrite(in2,LOW);\n  digitalWrite(in3,0);\n  digitalWrite(in4,LOW);\n  analogWrite(ena,0);\n  analogWrite(enb,0);\n}\nvoid left(){\n  digitalWrite(in1,HIGH);\n  digitalWrite(in2,LOW);\n  digitalWrite(in4,LOW);\n  digitalWrite(in3,HIGH);\n  analogWrite(ena,180);\n  analogWrite(enb,180);\n}\nvoid right(){\n  digitalWrite(in1,LOW);\n  digitalWrite(in2,HIGH);\n  digitalWrite(in4,HIGH);\n  digitalWrite(in3,LOW);\n  analogWrite(ena,180);\n  analogWrite(enb,180);\n}\nvoid back(){\n  digitalWrite(in1,HIGH);\n  digitalWrite(in2,LOW);\n  digitalWrite(in3,LOW);\n  digitalWrite(in4,HIGH);\n  analogWrite(ena,180);\n  analogWrite(enb,180);\n}\nvoid setup(){\n  pinMode(ena,OUTPUT);\n  pinMode(enb,OUTPUT);\n  pinMode(in1,OUTPUT);\n  pinMode(in2,OUTPUT);\n  pinMode(in3,OUTPUT);\n  pinMode(in4,OUTPUT);\n  pinMode(echo,INPUT);\n  pinMode(trig,OUTPUT);\n  Serial.begin(9600);\n  servo.attach(A1);\n  servo.write(90);\n}\nvoid loop(){\n  int d=getDistance(),r,l;\n  Serial.println(d);\n  delay(1000);\n  if(d>30){\n    forward();\n  }\n  else{\n    stop();\n    delay(500);\n    servo.write(160);\n    r=getDistance();\n    delay(600);\n    servo.write(30);\n    l=getDistance();\n    delay(600);\n    servo.write(90);\n    delay(200);\n    if(r>=l){\n      back();\n      delay(500);\n      right();\n      delay(900);\n      forward();\n    }\n    else{\n      back();\n      delay(500);\n      left();\n      delay(900);\n      forward();\n    }\n  }\n}\n"
      },
      "main": "sketch.ino"
    }
